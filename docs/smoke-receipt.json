      "step": "pi.registry",
      "tools": [
        {
          "name": "read",
          "description": "Read UTF-8 text through LayerFS SDK on active branch. Returns bounded text and nextLine/truncation metadata; binary/images unsupported."
        },
        {
          "name": "bash",
          "description": "Mount active LayerFS branch, execute with GNU timeout, commit even on normal nonzero exit, then unmount. Timeout/cancellation discard changes after exec ends. Returns separate stdout/stderr/exitCode and commit metadata."
        },
        {
          "name": "powershell",
          "description": "Execute a PowerShell command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds."
        },
        {
          "name": "edit",
          "description": "LayerFS exact single-match replacement; SDK preserves supported metadata. Uses oldText/newText, not Pi edits[] or hashline anchors."
        },
        {
          "name": "write",
          "description": "Write UTF-8 file through LayerFS SDK; each call commits active branch. Parent directory must exist. No host fallback."
        },
        {
          "name": "grep",
          "description": "Search active branch through LayerFS fs.grep; SDK pattern semantics and pagination, no host filesystem access."
        },
        {
          "name": "find",
          "description": "Search active branch through LayerFS fs.glob; SDK pattern semantics and pagination, no host filesystem access."
        },
        {
          "name": "ls",
          "description": "List active branch through LayerFS SDK; supports SDK pagination."
        },
        {
          "name": "layerfs_status",
          "description": "Show project, branch, current commit, genesis layer, owned Workspace metadata, environment set/unset diagnostics and limitations."
        },
        {
          "name": "layerfs_commits",
          "description": "List active branch commits, newest first."
        },
        {
          "name": "layerfs_remove",
          "description": "Remove a file/directory on active branch through SDK fs.apply."
        },
        {
          "name": "layerfs_cleanup",
          "description": "Explicitly discard/unmount only Workspaces owned by this runtime. Refuses busy mounts; reports each cleanup failure."
        }
      ]
    },
